# ==============================================================================
# LedgerGraph — Production Environment Configuration
# ==============================================================================

# Operation Mode: 'live' uses real external APIs; 'mock' uses local fixtures & fallback
MODE=live

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Extraction (Multimodal OCR & Field Parsing)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. FalkorDB Graph Database & Redis
# ------------------------------------------------------------------------------
# When running locally via docker compose:
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=

# For FalkorDB Cloud (e.g. falkordb://default:pass@host:port):
# FALKORDB_HOST=your-falkordb-cloud-host.com
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=your-secure-password

REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Session
# ------------------------------------------------------------------------------
# Generate a strong 256-bit random key for production JWT signatures:
# openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS origins (comma-separated):
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,https://app.yourdomain.com
MAX_UPLOAD_SIZE_MB=15

# ------------------------------------------------------------------------------
# 4. Meta WhatsApp Business Cloud API
# ------------------------------------------------------------------------------
# From Meta Developer Portal: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_APP_SECRET=

# ------------------------------------------------------------------------------
# 5. GST Suvidha Provider (GSP) / GSTN Portal
# ------------------------------------------------------------------------------
# Credentials from your certified GSP partner (e.g. Masters India, ClearTax, Cygnet):
GSP_BASE_URL=https://api.gsp.nic.in
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 6. TallyPrime Bridge (Direct XML Sync)
# ------------------------------------------------------------------------------
# Host & port of on-premise TallyPrime XML Server (F12 -> Advanced Configuration)
TALLY_HOST=localhost
TALLY_PORT=9000
